# Subway IRC Client - Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL="file:./subway.db"

# Server
NODE_ENV=development
PORT=3000

# Security (REQUIRED in production - generate with: openssl rand -base64 32)
COOKIE_SECRET=your-secret-key-here-minimum-32-characters

# BCrypt rounds (10-14 recommended, higher = slower but more secure)
BCRYPT_ROUNDS=12

# Session max age in milliseconds (default: 24 hours)
SESSION_MAX_AGE=86400000

# Debug token (optional, for debug namespace authentication)
# DEBUG_TOKEN=your-debug-token-here
